---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const allNotes = await getCollection('finerenone');
const sorted = allNotes.sort((a, b) => a.data.question_id.localeCompare(b.data.question_id));
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<BaseHead
			title={`Finerenone 臨床決策筆記 | ${SITE_TITLE}`}
			description="Finerenone (nonsteroidal MRA) 在 DKD 與心腎保護的臨床決策問題。整合 FIDELIO-DKD、FIGARO-DKD、FIDELITY、CONFIDENCE、FINEARTS-HF 證據與台灣健保實務。"
		/>
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			h1 {
				font-size: 2em;
				margin-bottom: 0.3em;
			}
			.subtitle {
				color: rgb(var(--gray));
				font-size: 1.05em;
				margin-bottom: 2em;
			}
			.card-download {
				display: block;
				text-decoration: none;
				border: 1px solid rgb(var(--gray-light));
				border-left: 4px solid #d4913a;
				border-radius: 6px;
				padding: 0.8em 1em;
				margin-bottom: 2em;
				background: rgba(212, 145, 58, 0.06);
				transition: background 0.15s;
			}
			.card-download:hover {
				background: rgba(212, 145, 58, 0.12);
			}
			.card-download .cd-title {
				font-weight: 700;
				color: #b5711a;
			}
			.card-download .cd-sub {
				display: block;
				font-size: 0.82em;
				color: rgb(var(--gray));
				margin-top: 0.25em;
			}
			.note-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.note-list li {
				padding: 0.5em 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.note-list li:last-child {
				border-bottom: none;
			}
			.note-link {
				text-decoration: none;
				display: block;
			}
			.note-link:hover .note-title {
				color: #d4913a;
			}
			.note-title {
				font-weight: 600;
			}
			.note-id {
				font-weight: 700;
				color: #b5711a;
				margin-right: 0.3em;
			}
			.note-meta {
				font-size: 0.8em;
				color: rgb(var(--gray));
				margin-top: 0.2em;
			}
			.empty-msg {
				color: rgb(var(--gray));
				font-style: italic;
				font-size: 0.9em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Finerenone 臨床決策筆記</h1>
			<p class="subtitle">Finerenone (nonsteroidal MRA) 在 DKD 與心腎保護的臨床決策問題。整合 FIDELIO-DKD、FIGARO-DKD、FIDELITY、CONFIDENCE、FINEARTS-HF 證據，對照 KDIGO、ADA、FDA/EMA 指引與台灣健保實務。</p>

			<a class="card-download" href="/downloads/finerenone-monitoring-card.html" target="_blank" rel="noopener">
				<span class="cd-title">🖨 Finerenone 起始與監測卡（A4 可列印）</span>
				<span class="cd-sub">起始條件・依 eGFR 劑量・K⁺ 調整與 hold/restart・監測時程・FIDELITY 高血鉀風險分數 — 一頁速查</span>
			</a>

			{sorted.length > 0 ? (
				<ul class="note-list">
					{sorted.map((note) => (
						<li>
							<a class="note-link" href={`/finerenone/${note.id}/`}>
								<span class="note-title">
									<span class="note-id">{note.data.question_id}</span>
									{note.data.title}
								</span>
								<div class="note-meta">
									{note.data.version} | 更新：<FormattedDate date={note.data.last_updated} />
								</div>
							</a>
						</li>
					))}
				</ul>
			) : (
				<p class="empty-msg">筆記準備中...</p>
			)}
		</main>
		<Footer />
	</body>
</html>
