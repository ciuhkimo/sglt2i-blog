---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { organization, organizationRef } from '../../lib/schema/organization';

// 只列已醫師審閱的週報；needs_physician_review 草稿不對外公開。
const all = await getCollection('regulatory');
const sorted = all
	.filter((p) => p.data.review_status === 'physician_reviewed')
	.sort((a, b) => b.data.last_updated.valueOf() - a.data.last_updated.valueOf());

const siteBase = 'https://nephrodecisions.com';
const collectionLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@graph': [
		organization,
		{
			'@type': 'CollectionPage',
			'@id': `${siteBase}/regulatory/#collection`,
			url: `${siteBase}/regulatory/`,
			name: '台灣醫藥監管週報',
			description:
				'每週整理食藥署（TFDA）、衛福部（MOHW）官方公告，以及與腎臟科相關的 FDA／EMA 國際訊息中，和藥品、醫療器材、臨床試驗、查驗登記、GMP/GDP 與藥品安全相關的重點。醫師審閱後發布。',
			isPartOf: organizationRef,
			publisher: organizationRef,
			mainEntity: {
				'@type': 'ItemList',
				itemListElement: sorted.map((post, i) => ({
					'@type': 'ListItem',
					position: i + 1,
					url: `${siteBase}/regulatory/${post.id}/`,
					name: post.data.title,
				})),
			},
		},
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: '首頁', item: `${siteBase}/` },
				{ '@type': 'ListItem', position: 2, name: '台灣醫藥監管週報', item: `${siteBase}/regulatory/` },
			],
		},
	],
});
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<BaseHead
			title={`台灣醫藥監管週報 | ${SITE_TITLE}`}
			description="每週整理食藥署（TFDA）、衛福部（MOHW）公告與腎臟科相關的 FDA／EMA 國際訊息中，與藥品、醫療器材、臨床試驗、查驗登記、GMP/GDP 與藥品安全相關的重點，給臨床同行與照護團隊閱讀。以主管機關公告原文為準。"
		/>
		<link rel="alternate" type="application/rss+xml" title="台灣醫藥監管週報" href="/regulatory/rss.xml" />
		<script type="application/ld+json" set:html={collectionLd} />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			h1 {
				font-size: 2em;
				margin-bottom: 0.3em;
			}
			.intro {
				color: rgb(var(--gray));
				font-size: 1em;
				margin-bottom: 1em;
				line-height: 1.7;
			}
			.scope-note {
				margin-bottom: 2em;
				padding: 0.8em 1em;
				background: #f8fafc;
				border-left: 4px solid var(--accent);
				border-radius: 4px;
				font-size: 0.85em;
				color: rgb(var(--gray-dark));
				line-height: 1.6;
			}
			.post-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.post-list li {
				padding: 1em 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.post-list li:last-child {
				border-bottom: none;
			}
			.post-link {
				text-decoration: none;
				display: block;
			}
			.post-link:hover .post-title {
				color: var(--accent);
			}
			.post-title {
				font-weight: 600;
				font-size: 1.1em;
			}
			.post-desc {
				font-size: 0.9em;
				color: rgb(var(--gray));
				margin-top: 0.3em;
				line-height: 1.5;
			}
			.post-meta {
				font-size: 0.8em;
				color: rgb(var(--gray));
				margin-top: 0.3em;
			}
			.empty {
				color: rgb(var(--gray));
				font-size: 0.95em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>台灣醫藥監管週報</h1>
			<p class="intro">
				每週整理食藥署（TFDA）與衛福部（MOHW）官方公告，以及與腎臟科相關的 FDA／EMA 國際訊息中，和藥品、醫療器材、臨床試驗、查驗登記、GMP/GDP、藥品安全與供應相關的重點，整理成給臨床同行與照護團隊閱讀的摘要。
			</p>
			<p class="scope-note">
				這是專業更新欄位，不是公告全文轉載牆。機器負責掃描與初整，醫師負責判斷與發布；所有項目均附官方原文連結，<strong>實際作業以主管機關公告原文為準</strong>。
			</p>

			{sorted.length > 0 ? (
				<ul class="post-list">
					{sorted.map((post) => (
						<li>
							<a class="post-link" href={`/regulatory/${post.id}/`}>
								<span class="post-title">{post.data.title}</span>
								<div class="post-desc">{post.data.description}</div>
								<div class="post-meta">
									<FormattedDate date={post.data.last_updated} />
									{post.data.ai_assisted ? ' ｜ AI 協助彙整、醫師審閱' : ' ｜ 醫師審閱'}
								</div>
							</a>
						</li>
					))}
				</ul>
			) : (
				<p class="empty">首期週報審閱中，近期上線。</p>
			)}
		</main>
		<Footer />
	</body>
</html>
