---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import { authorPerson } from '../lib/schema/authorPerson';
import { organization, organizationRef } from '../lib/schema/organization';

const sglt2iNotes = await getCollection('sglt2i');
const glp1raNotes = await getCollection('glp1ra');
const finerenoneNotes = await getCollection('finerenone');
const ckmNotes = await getCollection('ckm');
const paNotes = await getCollection('pa');
const sexualHealthNotes = await getCollection('sexualHealth');
const patientNotes = await getCollection('patient');
const dialysisNotes = await getCollection('dialysis');
const blogNotes = await getCollection('blog');
const ruralNephrologyNotes = await getCollection('ruralNephrology');

const totalDecisionNotes = sglt2iNotes.length + glp1raNotes.length + finerenoneNotes.length + ckmNotes.length + paNotes.length;
const totalAll = totalDecisionNotes + sexualHealthNotes.length + patientNotes.length + dialysisNotes.length + blogNotes.length;

// 「最近更新」: 合併所有 collection、按 last_updated 排序、取最新 7 篇
type RecentEntry = {
	title: string;
	last_updated: Date;
	href: string;
	clusterLabel: string;
	icon: string;
};

const collectionMeta: Record<string, { label: string; icon: string; pathPrefix: string }> = {
	sglt2i: { label: 'SGLT2i 決策筆記', icon: '💊', pathPrefix: '/sglt2i/' },
	glp1ra: { label: 'GLP-1 RA 決策筆記', icon: '💉', pathPrefix: '/glp1ra/' },
	finerenone: { label: 'Finerenone 決策筆記', icon: '🛡️', pathPrefix: '/finerenone/' },
	ckm: { label: 'CKM Syndrome', icon: '\u{1FAC0}', pathPrefix: '/ckm/' },
	pa: { label: 'Primary Aldosteronism 決策筆記', icon: '🧪', pathPrefix: '/pa/' },
	sexualHealth: { label: '腎友與性', icon: '❤️‍🩹', pathPrefix: '/sexual-health/' },
	patient: { label: '給病人與家屬', icon: '👨‍👩‍👧', pathPrefix: '/patient/' },
	dialysis: { label: '透析衛教', icon: '🏥', pathPrefix: '/dialysis/' },
	blog: { label: '臨床專題', icon: '📋', pathPrefix: '/blog/' },
};

const allEntries: RecentEntry[] = [
	...sglt2iNotes.map((e) => ({ collection: 'sglt2i', entry: e })),
	...glp1raNotes.map((e) => ({ collection: 'glp1ra', entry: e })),
	...finerenoneNotes.map((e) => ({ collection: 'finerenone', entry: e })),
	...ckmNotes.map((e) => ({ collection: 'ckm', entry: e })),
	...paNotes.map((e) => ({ collection: 'pa', entry: e })),
	...sexualHealthNotes.map((e) => ({ collection: 'sexualHealth', entry: e })),
	...patientNotes.map((e) => ({ collection: 'patient', entry: e })),
	...dialysisNotes.map((e) => ({ collection: 'dialysis', entry: e })),
	...blogNotes.map((e) => ({ collection: 'blog', entry: e })),
].map(({ collection, entry }) => {
	const meta = collectionMeta[collection];
	const data: any = entry.data;
	return {
		title: data.title,
		last_updated: data.last_updated,
		href: `${meta.pathPrefix}${entry.id.replace(/\.mdx?$/, '')}/`,
		clusterLabel: meta.label,
		icon: meta.icon,
	};
});

const recentEntries = allEntries
	.sort((a, b) => b.last_updated.getTime() - a.last_updated.getTime())
	.slice(0, 7);

const formatDate = (d: Date) => {
	const yyyy = d.getFullYear();
	const mm = String(d.getMonth() + 1).padStart(2, '0');
	const dd = String(d.getDate()).padStart(2, '0');
	return `${yyyy}-${mm}-${dd}`;
};

// 各 collection 的最新更新日期（給 cluster card 顯示用）
const getLatestDate = (notes: any[]): Date | null => {
	if (!notes.length) return null;
	return notes.reduce<Date>((max, e) => {
		const d = e.data.last_updated as Date;
		return !max || d > max ? d : max;
	}, null as any);
};

const latestSglt2i = getLatestDate(sglt2iNotes);
const latestGlp1ra = getLatestDate(glp1raNotes);
const latestFinerenone = getLatestDate(finerenoneNotes);
const latestCkm = getLatestDate(ckmNotes);
const latestPa = getLatestDate(paNotes);
const latestSexualHealth = getLatestDate(sexualHealthNotes);
const latestPatient = getLatestDate(patientNotes);
const latestDialysis = getLatestDate(dialysisNotes);
const latestBlog = getLatestDate(blogNotes);
const latestRural = getLatestDate(ruralNephrologyNotes);

const groups = [
	{
		title: '藥物決策',
		id: 'group-drugs',
		subtitle: '腎臟科核心藥物的臨床決策問題，從啟用到停藥的完整思路。',
		cards: [
			{
				title: 'SGLT2i 決策筆記',
				description: '涵蓋啟用時機、風險評估、監測判讀、暫停重啟與特殊族群。',
				count: sglt2iNotes.length,
				unit: '篇',
				href: '/sglt2i/',
				color: '#e8f4f0',
				accent: 'var(--accent)',
				icon: '💊',
				latest: latestSglt2i,
			},
			{
				title: 'GLP-1 RA 決策筆記',
				description: '以 FLOW trial 為核心，涵蓋啟用、排序、安全性與四柱整合。',
				count: glp1raNotes.length,
				unit: '篇',
				href: '/glp1ra/',
				color: '#fef5e7',
				accent: '#8a5c10',
				icon: '💉',
				latest: latestGlp1ra,
			},
			{
				title: 'Finerenone 決策筆記',
				description: '整合 FIDELIO、FIGARO、FIDELITY、CONFIDENCE 證據，涵蓋啟用、排序、高血鉀管理與台灣健保實務。',
				count: finerenoneNotes.length,
				unit: '篇',
				href: '/finerenone/',
				color: '#eef0f7',
				accent: '#4a5699',
				icon: '🛡️',
				latest: latestFinerenone,
			},
		],
	},
	{
		title: '臨床專區',
		id: 'group-clinical',
		subtitle: '針對特定臨床主題的系統性深度整理。',
		cards: [
			{
				title: 'CKM Syndrome 決策筆記',
				description: '心腎代謝症候群（CKM）的臨床決策。涵蓋 CKM 分期、心腎交互、代謝手術、四柱整合與風險分層。',
				count: ckmNotes.length,
				unit: '篇',
				href: '/ckm/',
				color: '#f0e8f5',
				accent: '#634a8a',
				icon: '\u{1FAC0}',
				latest: latestCkm,
			},
			{
				title: 'Primary Aldosteronism 決策筆記',
				description: '原發性醛固酮症（PA）的篩檢、確診、治療策略與台灣健保實務。整合 2025 ES guideline、2025 Taipei Positional Paper、TAIPAI cohort。',
				count: paNotes.length,
				unit: '篇',
				href: '/pa/',
				color: '#e8f0f5',
				accent: '#3a6080',
				icon: '🧪',
				latest: latestPa,
			},
			{
				title: '偏鄉腎臟照護',
				description: '南部偏鄉地區腎臟科視角，CKD 早期、CKD5 透析準備、HD/PD 在地照護、AKI 上轉、移植 shared care、CKM 與末期腎病安寧的完整 care continuum。',
				count: ruralNephrologyNotes.length,
				unit: '篇 hub',
				href: '/rural-nephrology/',
				color: '#f0f5ee',
				accent: '#4a6a3a',
				icon: '🏞️',
				latest: latestRural,
			},
			{
				title: '腎友與性',
				description: '透析病人的性功能、月經、生育與親密關係。涵蓋病人衛教與臨床決策筆記，男女都有。',
				count: sexualHealthNotes.length,
				unit: '篇',
				href: '/sexual-health/',
				color: '#fce4ec',
				accent: '#9b4060',
				icon: '❤️‍🩹',
				latest: latestSexualHealth,
			},
			{
				title: '臨床專題',
				description: '教科書著墨不多的實務問題——透析掉髮、台灣腎病趨勢等。',
				count: blogNotes.length,
				unit: '篇',
				href: '/blog/',
				color: '#f3f0f5',
				accent: '#634a8a',
				icon: '📋',
				latest: latestBlog,
			},
		],
	},
	{
		title: '衛教資源',
		id: 'group-edu',
		subtitle: '用白話中文，讓病人、家屬與護理團隊都能用的學習資源。',
		cards: [
			{
				title: '給病人與家屬',
				description: '用白話中文說明腎臟用藥的常見問題，幫助病人和家屬在看診前後更了解自己的治療。',
				count: patientNotes.length,
				unit: '篇',
				href: '/patient/',
				color: '#f0f4ff',
				accent: '#4a6fa5',
				icon: '👨‍👩‍👧',
				latest: latestPatient,
			},
			{
				title: '透析衛教——護理版',
				description: '以護理實務為導向的透析照護學習筆記。涵蓋併發症處理、飲食營養、水分控制、感染預防。',
				count: dialysisNotes.length,
				unit: '篇',
				href: '/dialysis/',
				color: '#f5f3ef',
				accent: '#6e5a3f',
				icon: '🏥',
				latest: latestDialysis,
			},
		],
	},
];
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@graph': [
				organization,
				authorPerson,
				{
					'@type': 'WebSite',
					name: 'Nephro Decisions',
					url: 'https://nephrodecisions.com/',
					description: '給病人與同行的台灣腎臟科決策知識庫——藥物決策、透析照護、偏鄉視角與病人衛教。',
					inLanguage: 'zh-Hant',
					publisher: organizationRef,
				},
			],
		})} />
		<style>
			main {
				width: 880px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}

			/* Hero */
			.hero {
				text-align: center;
				margin-bottom: 3em;
				padding: 2em 0;
			}
			.hero h1 {
				font-size: 2.4em;
				margin-bottom: 0.3em;
				color: var(--accent-dark);
			}
			.hero .tagline {
				font-size: 1.15em;
				color: rgb(var(--gray));
				max-width: 600px;
				margin: 0 auto 1.5em;
				line-height: 1.7;
			}
			.hero .stats {
				display: flex;
				justify-content: center;
				gap: 2em;
				flex-wrap: wrap;
				font-size: 0.9em;
				color: rgb(var(--gray));
			}
			.hero .stat-num {
				font-size: 1.8em;
				font-weight: 700;
				color: var(--accent-dark);
				display: block;
			}
			.last-updated-banner {
				margin: 1.5em auto 0;
				font-size: 0.88em;
				color: rgb(var(--gray));
				text-align: center;
				display: inline-flex;
				align-items: center;
				gap: 0.5em;
				padding: 0.4em 1em;
				background: rgba(var(--accent-rgb, 26, 117, 86), 0.07);
				border-radius: 999px;
				max-width: 100%;
			}
			.last-updated-banner a {
				color: var(--accent-dark);
				text-decoration: none;
				font-weight: 500;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
				max-width: 60ch;
			}
			.last-updated-banner a:hover {
				text-decoration: underline;
			}
			.last-updated-dot {
				width: 0.5em;
				height: 0.5em;
				border-radius: 50%;
				background: #4caf50;
				flex-shrink: 0;
				box-shadow: 0 0 0 0 rgba(76, 175, 80, 0.6);
				animation: pulse 2.4s ease-in-out infinite;
			}
			@keyframes pulse {
				0%, 100% { box-shadow: 0 0 0 0 rgba(76, 175, 80, 0.4); }
				50% { box-shadow: 0 0 0 6px rgba(76, 175, 80, 0); }
			}

			/* Intent strip — 輕量受眾錨點列（非 door card、無 JS） */
			.intent-strip {
				display: flex;
				justify-content: center;
				flex-wrap: wrap;
				gap: 0.6em 1.6em;
				max-width: 760px;
				margin: 0 auto 2.5em;
				padding: 0.85em 1em;
				border-top: 1px solid rgb(var(--gray-light));
				border-bottom: 1px solid rgb(var(--gray-light));
				font-size: 0.92em;
			}
			.intent-strip .intent-link {
				color: var(--accent-dark);
				text-decoration: none;
				font-weight: 500;
				white-space: nowrap;
			}
			.intent-strip .intent-link:hover {
				text-decoration: underline;
			}
			@media (max-width: 600px) {
				.intent-strip {
					flex-direction: column;
					align-items: center;
					gap: 0.7em;
					text-align: center;
				}
			}

			/* Section groups */
			.section-group {
				margin-bottom: 2.5em;
			}
			.section-group-header {
				margin-bottom: 1em;
			}
			.section-group-header h2 {
				font-size: 1.4em;
				color: var(--accent-dark);
				margin: 0 0 0.2em;
				border-left: 4px solid var(--accent);
				padding-left: 0.6em;
			}
			.section-group-header p {
				font-size: 0.9em;
				color: rgb(var(--gray));
				margin: 0;
				padding-left: 1.2em;
			}

			/* Cards grid */
			.cards {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 1.2em;
			}
			.card {
				border-radius: 10px;
				padding: 1.6em;
				text-decoration: none;
				color: rgb(var(--gray-dark));
				transition: transform 0.15s, box-shadow 0.15s;
				display: flex;
				flex-direction: column;
			}
			.card:hover {
				transform: translateY(-3px);
				box-shadow: 0 6px 20px rgba(0,0,0,0.1);
				color: rgb(var(--gray-dark));
			}
			.card-icon {
				font-size: 1.8em;
				margin-bottom: 0.4em;
			}
			.card h3 {
				font-size: 1.15em;
				margin: 0 0 0.3em;
			}
			.card .card-desc {
				font-size: 0.88em;
				color: rgb(var(--gray));
				line-height: 1.6;
				flex-grow: 1;
			}
			.card .card-meta {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 0.6em;
				margin-top: 0.8em;
			}
			.card .card-count {
				font-size: 0.85em;
				font-weight: 600;
			}
			.card .card-latest {
				font-size: 0.78em;
				color: rgb(var(--gray));
				font-variant-numeric: tabular-nums;
				white-space: nowrap;
			}
			.card .card-cta {
				margin-top: 0.5em;
				font-size: 0.9em;
				font-weight: 600;
			}

			/* Recent Updates */
			.recent-updates {
				margin: 0 0 2em;
				padding: 1.5em 1em;
				background: #fafbfc;
				border-radius: 12px;
				border: 1px solid rgb(var(--gray-light));
			}
			.recent-updates h2 {
				font-size: 1.3em;
				color: var(--accent-dark);
				margin: 0 0 1em;
				text-align: center;
			}
			.recent-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.recent-item {
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.recent-item:last-child {
				border-bottom: none;
			}
			.recent-item a {
				display: grid;
				grid-template-columns: auto auto 1fr auto;
				gap: 0.6em 0.8em;
				align-items: center;
				padding: 0.7em 0.5em;
				color: inherit;
				text-decoration: none;
				transition: background 0.15s;
			}
			.recent-item a:hover {
				background: rgb(var(--gray-light));
				border-radius: 6px;
			}
			.recent-icon {
				font-size: 1.1em;
			}
			.recent-date {
				font-size: 0.82em;
				color: rgb(var(--gray));
				font-variant-numeric: tabular-nums;
				white-space: nowrap;
			}
			.recent-title {
				font-size: 0.95em;
				font-weight: 500;
				min-width: 0;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}
			.recent-cluster {
				font-size: 0.78em;
				color: rgb(var(--gray));
				background: rgba(0, 0, 0, 0.04);
				padding: 0.15em 0.6em;
				border-radius: 10px;
				white-space: nowrap;
			}
			@media (max-width: 600px) {
				.recent-item a {
					grid-template-columns: auto auto 1fr;
					grid-template-areas:
						"icon date cluster"
						"title title title";
					gap: 0.3em 0.6em;
				}
				.recent-icon {
					grid-area: icon;
				}
				.recent-date {
					grid-area: date;
				}
				.recent-cluster {
					grid-area: cluster;
					justify-self: end;
				}
				.recent-title {
					grid-area: title;
					white-space: normal;
					font-size: 0.92em;
				}
			}

			/* Subscribe */
			.subscribe-section {
				text-align: center;
				padding: 2.5em 1em;
				margin-bottom: 1em;
				background: #f0f4f3;
				border-radius: 12px;
			}
			.subscribe-section h2 {
				font-size: 1.3em;
				color: var(--accent-dark);
				margin: 0 0 0.3em;
			}
			.subscribe-section > p {
				font-size: 0.95em;
				color: rgb(var(--gray));
				margin: 0 0 1.2em;
			}
			.subscribe-form {
				display: flex;
				justify-content: center;
				gap: 0.5em;
				flex-wrap: wrap;
				max-width: 420px;
				margin: 0 auto;
			}
			.subscribe-form input[type="email"] {
				flex: 1;
				min-width: 200px;
				padding: 0.6em 1em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 6px;
				font-size: 0.95em;
			}
			.subscribe-form button {
				padding: 0.6em 1.5em;
				background: var(--accent);
				color: #fff;
				border: none;
				border-radius: 6px;
				font-size: 0.95em;
				font-weight: 600;
				cursor: pointer;
			}
			.subscribe-form button:hover {
				background: var(--accent-dark);
			}
			.subscribe-note {
				font-size: 0.8em;
				color: rgb(var(--gray));
				margin-top: 0.8em;
			}
			.subscribe-note a {
				color: var(--accent);
			}

			/* About preview */
			.about-preview {
				text-align: center;
				padding: 2.5em 1em;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.about-preview .author {
				font-size: 1.1em;
				font-weight: 600;
				color: rgb(var(--gray-dark));
				margin-bottom: 0.5em;
			}
			.about-preview p {
				font-size: 0.95em;
				color: rgb(var(--gray));
				max-width: 550px;
				margin: 0 auto 1em;
				line-height: 1.7;
			}
			.about-preview a {
				color: var(--accent);
				text-decoration: none;
				font-weight: 600;
			}
			.about-preview a:hover {
				text-decoration: underline;
			}

			@media (max-width: 720px) {
				.hero h1 {
					font-size: 1.8em;
				}
				.cards {
					grid-template-columns: 1fr;
				}
				.hero .stats {
					gap: 1.2em;
				}
				.last-updated-banner {
					font-size: 0.8em;
					padding: 0.4em 0.8em;
					flex-wrap: wrap;
					justify-content: center;
				}
				.last-updated-banner a {
					max-width: 90vw;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<section class="hero">
				<h1>Nephro Decisions</h1>
				<p class="tagline">腎臟科臨床決策知識庫——從實證到實務，涵蓋藥物決策、透析照護與病人衛教。由腎臟科專科醫師主導，AI 輔助研究與多輪交替審稿。</p>
				<div class="stats">
					<div><span class="stat-num">{totalAll}</span>篇文章</div>
					<div><span class="stat-num">{totalDecisionNotes}</span>決策筆記</div>
					<div><span class="stat-num">{sexualHealthNotes.length}</span>腎友與性</div>
					<div><span class="stat-num">{patientNotes.length + dialysisNotes.length}</span>衛教資源</div>
				</div>
				{recentEntries.length > 0 && (
					<p class="last-updated-banner">
						<span class="last-updated-dot" aria-hidden="true"></span>
						最新更新：<a href={recentEntries[0].href}>{formatDate(recentEntries[0].last_updated)}　{recentEntries[0].title}</a>
					</p>
				)}
			</section>

			<nav class="intent-strip" aria-label="依需求快速導覽">
				<a class="intent-link" href="#group-drugs">同業找臨床決策題　→</a>
				<a class="intent-link" href="/patient/">病人與家屬看白話衛教　→</a>
				<a class="intent-link" href="/about/">先認識作者、再決定信不信　→</a>
			</nav>

			{groups.map((group) => (
				<section class="section-group" id={group.id}>
					<div class="section-group-header">
						<h2>{group.title}</h2>
						<p>{group.subtitle}</p>
					</div>
					<div class="cards">
						{group.cards.map((s) => (
							<a class="card" href={s.href} style={`background: ${s.color};`}>
								<span class="card-icon">{s.icon}</span>
								<h3>{s.title}</h3>
								<p class="card-desc">{s.description}</p>
								<div class="card-meta">
									<span class="card-count" style={`color: ${s.accent};`}>{s.count} {s.unit}</span>
									{s.latest && <span class="card-latest">最新 {formatDate(s.latest)}</span>}
								</div>
								<span class="card-cta" style={`color: ${s.accent};`}>前往 →</span>
							</a>
						))}
					</div>
				</section>
			))}

			<section class="recent-updates">
				<h2>最近更新</h2>
				<ul class="recent-list">
					{recentEntries.map((entry) => (
						<li class="recent-item">
							<a href={entry.href}>
								<span class="recent-icon">{entry.icon}</span>
								<span class="recent-date">{formatDate(entry.last_updated)}</span>
								<span class="recent-title">{entry.title}</span>
								<span class="recent-cluster">{entry.clusterLabel}</span>
							</a>
						</li>
					))}
				</ul>
			</section>

			<section class="subscribe-section">
				<h2>訂閱更新</h2>
				<p>新的臨床決策筆記發布時，直接寄到你的信箱。不灌水、不賣東西。</p>
				<form
					action="https://buttondown.com/api/emails/embed-subscribe/nephrodecisions"
					method="post"
					target="popupwindow"
					class="subscribe-form"
				>
					<label for="home-subscribe-email" class="sr-only">電子郵件地址</label>
					<input type="email" name="email" id="home-subscribe-email" placeholder="your@email.com" required aria-label="電子郵件地址" />
					<button type="submit">訂閱</button>
				</form>
				<p class="subscribe-note">也可透過 <a href="/rss.xml">RSS</a> 追蹤</p>
			</section>

			<section class="about-preview">
				<p class="author">小鎮醫生｜腎臟科專科醫師｜內科專科醫師</p>
				<p class="author" style="font-weight: 400; font-size: 0.9em; opacity: 0.85;">學歷：台灣大學醫學系</p>
				<p>每篇筆記經過臨床問題定義、多平台文獻研究、AI 與人工交替審稿的七步驟流程產出。內容以實證為基礎，結合台灣臨床實務。</p>
				<a href="/about/">了解更多 →</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
