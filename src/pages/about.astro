---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { authorPerson, authorPersonRef } from '../lib/schema/authorPerson';
import { organization } from '../lib/schema/organization';

const profileLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@graph': [
		organization,
		authorPerson,
		{
			'@type': 'ProfilePage',
			mainEntity: authorPersonRef,
			url: 'https://nephrodecisions.com/about/',
		},
	],
});
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<BaseHead title={`關於 | ${SITE_TITLE}`} description="關於本站與作者" />
		<script type="application/ld+json" set:html={profileLd} />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			h1 {
				font-size: 2em;
				margin-bottom: 1em;
			}
			h2 {
				font-size: 1.4em;
				margin-top: 2em;
				margin-bottom: 0.5em;
			}
			.author-info {
				font-size: 1.1em;
				font-weight: 600;
				color: rgb(var(--gray-dark));
				margin-bottom: 1.5em;
			}
			ol {
				padding-left: 1.5em;
			}
			ol li {
				margin-bottom: 0.5em;
			}
			.disclaimer {
				margin-top: 2.5em;
				padding: 1.2em;
				background: rgb(var(--gray-light));
				border-radius: 8px;
				font-size: 0.9em;
				color: rgb(var(--gray-dark));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>關於本站</h1>

			<p class="author-info">小鎮醫生｜腎臟科專科醫師｜內科專科醫師</p>
			<p class="author-info" style="font-weight: 400; font-size: 0.95em; color: rgb(var(--gray));">學歷：台灣大學醫學系</p>

			<p>
				Nephro Decisions 是腎臟科臨床決策知識庫，涵蓋 SGLT2 inhibitor、GLP-1 receptor agonist、透析照護、病人衛教與臨床專題等多元主題。
				每篇內容皆以實證為基礎，結合臨床情境設計，目標是讓腎臟科醫師與照護團隊在門診、病房與透析室中能快速參考、輔助判斷。
			</p>

			<h2>編輯流程</h2>
			<p>由醫師決定題目與臨床問題，運用 AI 工具協助文獻搜尋、證據整理與草稿製作。重要主張回查原始研究、官方指引或主管機關原文，必要時增加第二輪查核。內容經醫師審閱與核定後發布。</p>
			<ol>
				<li><strong>臨床題目</strong>——醫師從實際臨床情境決定題目、提出具體決策問題與臨床看法</li>
				<li><strong>文獻搜尋與證據整理</strong>——運用 AI 工具協助搜尋文獻、整理證據</li>
				<li><strong>整合與草稿</strong>——目前以 Claude Code 整合為結構化文章，並負責網站更新</li>
				<li><strong>回查原始資料</strong>——重要主張回查原始研究、官方指引或主管機關原文；必要時增加第二輪查核</li>
				<li><strong>醫師審閱與核定</strong>——醫師審閱、核定後發布，並標示最後更新日期</li>
			</ol>

			<p style="margin-top: 1em;">
				<a href="/editorial-policy/">完整編輯方針 →</a>
			</p>

			<h2>版本管理</h2>
			<p>
				每頁標示最後更新日期；決策筆記類文章另標註版本號。版本號反映內容修訂，不代表由哪個工具處理。當有重要指引更新或新證據發表時，將進行版本更新；事實更正會在文內註明。
			</p>

			<div class="disclaimer" id="disclaimer">
				<strong>免責聲明：</strong>本站內容為個人臨床學習整理，不代表任何機構立場。臨床決策應結合個別病人狀況與最新指引。
				本站內容不構成醫療建議，不應取代專業醫師的臨床判斷。
			</div>
		</main>
		<Footer />
	</body>
</html>
