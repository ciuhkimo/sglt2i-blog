---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const allNotes = await getCollection('pa');
const qNum = (id: string) => parseInt(id.replace(/\D/g, ''), 10);
const sorted = allNotes.sort((a, b) => qNum(a.data.question_id) - qNum(b.data.question_id));
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<BaseHead
			title={`Primary Aldosteronism (PA) 臨床決策筆記 | ${SITE_TITLE}`}
			description="原發性醛固酮症（Primary Aldosteronism, PA）在台灣腎臟科實務的臨床決策問題。整合 2025 Endocrine Society guideline、2024 ESC HTN guideline、2025 Taipei Positional Paper、TAIPAI Study Group 證據與健保實務。"
		/>
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			h1 {
				font-size: 2em;
				margin-bottom: 0.3em;
			}
			.subtitle {
				color: rgb(var(--gray));
				font-size: 1.05em;
				margin-bottom: 2em;
			}
			.card-download {
				display: block;
				text-decoration: none;
				border: 1px solid rgb(var(--gray-light));
				border-left: 4px solid #d4913a;
				border-radius: 6px;
				padding: 0.8em 1em;
				margin-bottom: 2em;
				background: rgba(212, 145, 58, 0.06);
				transition: background 0.15s;
			}
			.card-download:hover {
				background: rgba(212, 145, 58, 0.12);
			}
			.card-download .cd-title {
				font-weight: 700;
				color: #b5711a;
			}
			.card-download .cd-sub {
				display: block;
				font-size: 0.82em;
				color: rgb(var(--gray));
				margin-top: 0.25em;
			}
			.note-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.note-list li {
				padding: 0.5em 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.note-list li:last-child {
				border-bottom: none;
			}
			.note-link {
				text-decoration: none;
				display: block;
			}
			.note-link:hover .note-title {
				color: #d4913a;
			}
			.note-title {
				font-weight: 600;
			}
			.note-id {
				font-weight: 700;
				color: #b5711a;
				margin-right: 0.3em;
			}
			.note-meta {
				font-size: 0.8em;
				color: rgb(var(--gray));
				margin-top: 0.2em;
			}
			.empty-msg {
				color: rgb(var(--gray));
				font-style: italic;
				font-size: 0.9em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<h1>Primary Aldosteronism 臨床決策筆記</h1>
			<p class="subtitle">原發性醛固酮症在台灣腎臟科實務的決策問題，從篩檢、診斷、治療到治療後追蹤與共病。整合 2025 Endocrine Society guideline、2024 ESC HTN guideline、2025 Taipei Positional Paper、TAIPAI Study Group 證據與健保實務。</p>

			<a class="card-download" href="/patient/pa-hub/">
				<span class="cd-title">👤 給病人看的版本：原發性醛固酮症完整指南</span>
				<span class="cd-sub">高血壓背後的隱藏元兇——什麼是 PA、誰該檢查、怎麼診斷、有哪些治療（白話衛教 Hub）</span>
			</a>

			{sorted.length > 0 ? (
				<ul class="note-list">
					{sorted.map((note) => (
						<li>
							<a class="note-link" href={`/pa/${note.id}/`}>
								<span class="note-title">
									<span class="note-id">{note.data.question_id}</span>
									{note.data.title}
								</span>
								<div class="note-meta">
									{note.data.version} | 更新：<FormattedDate date={note.data.last_updated} />
								</div>
							</a>
						</li>
					))}
				</ul>
			) : (
				<p class="empty-msg">筆記準備中...</p>
			)}
		</main>
		<Footer />
	</body>
</html>
