<script>
	// table-wrapper a11y init: add role="region" + aria-label to every wrapper
	// (rehype properties for role/aria-label get stripped by Astro hast serialization)
	document.querySelectorAll('.table-wrapper').forEach((el) => {
		if (!el.getAttribute('role')) el.setAttribute('role', 'region');
		if (!el.getAttribute('aria-label')) el.setAttribute('aria-label', '表格可水平捲動');
		// keyboard scrollability — make wrapper focusable so users can Tab into it and arrow-scroll
		if (!el.hasAttribute('tabindex')) el.setAttribute('tabindex', '0');
	});
</script>

<script type="module">
	(async () => {
		// Mermaid DSL source is stored inside <script type="text/plain" class="mermaid-source">
		// (see astro.config.mjs::rehypeMermaidPreToDiv). Readability extractors reliably strip
		// script elements before extracting article text, so the DSL stays out of indexed
		// visible content. At runtime we read the script's textContent, materialize a
		// <div class="mermaid">, and ask Mermaid to render it to SVG. <noscript> fallback
		// covers users with JS disabled.
		const containers = document.querySelectorAll('div.mermaid-container');
		if (containers.length === 0) return;
		const targets = [];
		containers.forEach((c) => {
			c.setAttribute('role', 'img');
			c.setAttribute('aria-label', 'Mermaid 臨床決策流程圖');
			const src = (c.querySelector('script.mermaid-source')?.textContent || '').trim();
			if (!src) return;
			c.replaceChildren();
			const div = document.createElement('div');
			div.className = 'mermaid';
			div.textContent = src;
			c.appendChild(div);
			targets.push(div);
		});
		if (targets.length === 0) return;
		try {
			const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');
			mermaid.initialize({ startOnLoad: false, theme: 'default', securityLevel: 'loose' });
			await mermaid.run({ nodes: targets });
		} catch (e) {
			console.warn('Mermaid render error:', e);
		}
	})();
</script>

<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	footer a {
		color: rgb(var(--gray));
	}
	.mermaid-container,
	.mermaid {
		margin: 1.5em 0;
		padding: 1em;
		background: #fafafa;
		border-radius: 8px;
		overflow-x: auto;
		text-align: center;
	}
	.mermaid-container noscript {
		display: block;
		color: #666;
		font-style: italic;
		font-size: 0.95em;
	}
	.mermaid svg {
		max-width: 100%;
		height: auto;
	}
	@media print {
		.mermaid-container,
		.mermaid { background: transparent; padding: 0; }
		.mermaid svg { filter: grayscale(1); }
	}
</style>
