<script>
	// table-wrapper a11y init: add role="region" + aria-label to every wrapper
	// (rehype properties for role/aria-label get stripped by Astro hast serialization)
	document.querySelectorAll('.table-wrapper').forEach((el) => {
		if (!el.getAttribute('role')) el.setAttribute('role', 'region');
		if (!el.getAttribute('aria-label')) el.setAttribute('aria-label', '表格可水平捲動');
		// keyboard scrollability — make wrapper focusable so users can Tab into it and arrow-scroll
		if (!el.hasAttribute('tabindex')) el.setAttribute('tabindex', '0');
	});
</script>

<script type="module">
	(async () => {
		const blocks = document.querySelectorAll('pre[data-language="mermaid"]');
		if (blocks.length === 0) return;
		try {
			const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');
			mermaid.initialize({ startOnLoad: false, theme: 'default', securityLevel: 'loose' });
			blocks.forEach((pre) => {
				const code = pre.querySelector('code');
				if (!code) return;
				const text = code.textContent || '';
				const div = document.createElement('div');
				div.className = 'mermaid';
				div.setAttribute('role', 'img');
				div.setAttribute('aria-label', 'Mermaid 臨床決策流程圖');
				div.textContent = text;
				pre.replaceWith(div);
			});
			await mermaid.run({ querySelector: '.mermaid' });
		} catch (e) {
			console.warn('Mermaid render error:', e);
		}
	})();
</script>

<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	footer a {
		color: rgb(var(--gray));
	}
	.mermaid {
		margin: 1.5em 0;
		padding: 1em;
		background: #fafafa;
		border-radius: 8px;
		overflow-x: auto;
		text-align: center;
	}
	.mermaid svg {
		max-width: 100%;
		height: auto;
	}
	@media print {
		.mermaid { background: transparent; padding: 0; }
		.mermaid svg { filter: grayscale(1); }
	}
</style>
