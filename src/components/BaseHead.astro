---
import '../styles/global.css';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: string;
}

// Normalize canonical: always trailing slash, no query/hash
const rawPath = Astro.url.pathname;
const normalizedPath = rawPath === '/' ? '/' :
	rawPath.endsWith('/') ? rawPath : `${rawPath}/`;
const canonicalURL = new URL(normalizedPath, Astro.site);

const { title, description, image } = Astro.props;

// Auto-compute OG image URL from current pathname
// /sglt2i/q01-xxx/ → /og/sglt2i/q01-xxx.png
// / → /og/index.png
// /about/ → /og/about.png
const pathname = Astro.url.pathname.replace(/^\/|\/$/g, '');
const ogImagePath = pathname === '' ? '/og/index.png' : `/og/${pathname}.png`;
const ogImageURL = image ? new URL(image, Astro.url) : new URL(ogImagePath, Astro.site);
---

<!-- Google Analytics -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-Y6L20JKVXJ"></script>
<script>
	window.dataLayer = window.dataLayer || [];
	function gtag(){dataLayer.push(arguments);}
	gtag('js', new Date());

	// 內部流量標記（2026-08-30）。緣起：站上原本完全沒有內部流量排除，
	// 作者審稿與上線驗證的瀏覽都會混進正式數據；8/24 一次 GA4 異常偵測
	// 促成這次修正。標記後仍需在 GA4 後台建「內部流量」資料篩選器才會實際排除
	// （篩選器不追溯既有資料，且預設是「測試」狀態，要手動改成「啟用」）。
	//
	// 判定為內部的三種情況：
	//   1. localhost / 127.0.0.1 / *.local  → 開發與 preview
	//   2. 網址帶 ?nd_internal=1            → 一次性標記，並記住這台瀏覽器
	//   3. 這台瀏覽器先前標記過             → localStorage
	// 解除：任一頁加 ?nd_internal=0
	window.__ndInternal = (function () {
		try {
			var h = location.hostname;
			if (h === 'localhost' || h === '127.0.0.1' || h === '[::1]' || h.slice(-6) === '.local') return true;
			var q = new URLSearchParams(location.search).get('nd_internal');
			if (q === '1') { localStorage.setItem('nd_internal', '1'); return true; }
			if (q === '0') { localStorage.removeItem('nd_internal'); return false; }
			return localStorage.getItem('nd_internal') === '1';
		} catch (e) {
			return false;
		}
	})();

	gtag('config', 'G-Y6L20JKVXJ', window.__ndInternal ? { traffic_type: 'internal' } : {});
</script>

<!-- Google Search Console -->
<meta name="google-site-verification" content="Noc9o9LTMiNz_RTnDxdBwh9AA8t_xnmb5p8iW9Ti4lw" />

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content="zh_TW" />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<!-- Twitter -->
<!-- Twitter/X Cards：官方範例用 name=（og:* 才用 property=）。
     2026-08-24 外部稽核：歷史上 parser 兩者都吃，所以原本的 property= 並未讓分享卡失效；
     改成 name= 是 compatibility hardening，避免只找 meta[name] 的第三方工具誤判為缺漏。 -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
