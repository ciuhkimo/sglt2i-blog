---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ReadAloudButton from '../components/ReadAloudButton.astro';
import { authorPerson, authorPersonRef } from '../lib/schema/authorPerson';
import { organization, organizationRef } from '../lib/schema/organization';

type Props = CollectionEntry<'regulatory'>['data'];

const {
	title,
	description,
	last_updated,
	week_start,
	week_end,
	review_status,
	ai_assisted,
	seo_title,
	tags,
	source_scope,
} = Astro.props;

const isDraft = review_status !== 'physician_reviewed';

// JSON-LD：未審閱草稿不宣稱 reviewedBy，且整頁 noindex（見下方 head）
const graph = [
	organization,
	authorPerson,
	{
		'@type': ['MedicalWebPage', 'Article'],
		headline: title,
		name: title,
		datePublished: last_updated.toISOString(),
		dateModified: last_updated.toISOString(),
		author: authorPersonRef,
		publisher: organizationRef,
		...(isDraft
			? {}
			: { reviewedBy: authorPersonRef, lastReviewed: last_updated.toISOString().split('T')[0] }),
		medicalAudience: { '@type': 'MedicalAudience', audienceType: 'Clinician' },
	},
];
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });

const breadcrumbLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: '首頁', item: 'https://nephrodecisions.com/' },
		{ '@type': 'ListItem', position: 2, name: '台灣醫藥監管週報', item: 'https://nephrodecisions.com/regulatory/' },
		{ '@type': 'ListItem', position: 3, name: title },
	],
});
---

<html lang="zh-Hant">
	<head>
		<BaseHead title={seo_title || `${title} — 台灣醫藥監管週報`} description={description} />
		<link rel="alternate" type="application/rss+xml" title="台灣醫藥監管週報" href="/regulatory/rss.xml" />
		{isDraft && <meta name="robots" content="noindex, nofollow" />}
		<script type="application/ld+json" set:html={jsonLd} />
		{!isDraft && <script type="application/ld+json" set:html={breadcrumbLd} />}
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.breadcrumb {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 1em auto 0;
				padding: 0 1em;
				font-size: 0.85em;
				color: rgb(var(--gray));
			}
			.breadcrumb a {
				color: rgb(var(--gray));
				text-decoration: none;
			}
			.breadcrumb a:hover {
				color: var(--accent);
			}
			.draft-banner {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 1em auto 0;
				padding: 0.8em 1em;
				background: #fff7ed;
				border: 1px solid #fdba74;
				border-radius: 8px;
				color: #9a3412;
				font-size: 0.9em;
				font-weight: 600;
			}
			.reg-header {
				margin-bottom: 1.2em;
				padding-bottom: 1em;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.reg-header h1 {
				margin: 0 0 0.5em 0;
				font-size: 2em;
				line-height: 1.3;
			}
			.meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6em 1em;
				font-size: 0.85em;
				color: rgb(var(--gray));
			}
			.meta-item {
				display: flex;
				align-items: center;
				gap: 0.3em;
			}
			.meta-label {
				font-weight: 700;
			}
			.badge {
				padding: 0.1em 0.6em;
				border-radius: 999px;
				font-size: 0.8em;
				font-weight: 600;
			}
			.badge-reviewed {
				background: #ecfdf5;
				color: #065f46;
				border: 1px solid #6ee7b7;
			}
			.badge-draft {
				background: #fff7ed;
				color: #9a3412;
				border: 1px solid #fdba74;
			}
			.badge-ai {
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				border: 1px solid rgb(var(--gray-light));
			}
			.disclaimer {
				margin: 0 0 1.5em 0;
				padding: 0.8em 1em;
				background: #f8fafc;
				border-left: 4px solid var(--accent);
				border-radius: 4px;
				font-size: 0.85em;
				color: rgb(var(--gray-dark));
				line-height: 1.6;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				margin-top: 0.6em;
			}
			.tag {
				background: rgb(var(--gray-light));
				padding: 0.15em 0.6em;
				border-radius: 4px;
				font-size: 0.8em;
				color: rgb(var(--gray-dark));
			}
			.source-scope {
				margin: 2em 0 0;
				padding: 1em;
				background: #f8fafc;
				border-radius: 8px;
				font-size: 0.85em;
				color: rgb(var(--gray-dark));
			}
			.source-scope h2 {
				font-size: 1em;
				margin: 0 0 0.5em;
			}
			.source-scope ul {
				margin: 0;
				padding-left: 1.2em;
			}
			.editor-note {
				margin-top: 1.5em;
				font-size: 0.85em;
				color: rgb(var(--gray));
				line-height: 1.6;
			}
			.print-btn-wrapper {
				margin-bottom: 1.5em;
				text-align: right;
			}
			.print-btn {
				padding: 0.4em 1em;
				background: rgb(var(--gray-light));
				border: 1px solid rgb(var(--gray-light));
				border-radius: 6px;
				font-size: 0.85em;
				color: rgb(var(--gray-dark));
				cursor: pointer;
			}
			.print-btn:hover {
				background: #ddd;
			}
		</style>
	</head>

	<body>
		<Header />
		<main id="main-content">
			{isDraft && (
				<div class="draft-banner">
					🚧 本篇為 AI 自動彙整草稿，尚未經醫師審閱、未對外公開（noindex、未列入週報列表與 RSS）。內容僅供內部審稿，不得引用。
				</div>
			)}
			<nav class="breadcrumb">
				<a href="/">首頁</a> &rsaquo;
				<a href="/regulatory/">台灣醫藥監管週報</a> &rsaquo;
				<span>{title}</span>
			</nav>
			<article class="prose">
				<div class="reg-header">
					<h1>{title}</h1>
					<div class="meta">
						{(week_start && week_end) && (
							<span class="meta-item">
								<span class="meta-label">涵蓋期間：</span><FormattedDate date={week_start} />–<FormattedDate date={week_end} />
							</span>
						)}
						<span class="meta-item">
							<span class="meta-label">更新日期：</span><FormattedDate date={last_updated} />
						</span>
						<span class="meta-item">
							{review_status === 'physician_reviewed'
								? <span class="badge badge-reviewed">已醫師審閱</span>
								: <span class="badge badge-draft">草稿・未審閱</span>}
						</span>
						{ai_assisted && <span class="badge badge-ai">AI 協助彙整</span>}
					</div>
					{tags && tags.length > 0 && (
						<div class="tags">
							{tags.map((t) => <span class="tag">{t}</span>)}
						</div>
					)}
				</div>

				<p class="disclaimer">
					本文整理主管機關公開資訊，供教育與專業閱讀使用，不構成醫療、法律、藥政、查驗登記或採購建議。實際作業請以主管機關公告原文與所屬機構規範為準。
				</p>

				<div class="print-btn-wrapper">
					<ReadAloudButton />
					<button class="print-btn" onclick="window.print()">列印 / 存 PDF</button>
				</div>

				<slot />

				{source_scope && source_scope.length > 0 && (
					<div class="source-scope">
						<h2>本期掃描來源</h2>
						<ul>
							{source_scope.map((s) => <li>{s}</li>)}
						</ul>
					</div>
				)}

				<p class="editor-note">
					編輯註：本週報由 AI 協助彙整官方公開公告與新聞，再由腎臟科專科醫師審閱、篩選與定稿。臨床與實務解讀以人工審閱版本為準；所有項目均附官方原文連結，請以原文為準。
				</p>

				<div class="print-footer">
					<p>Nephro Decisions｜https://nephrodecisions.com{Astro.url.pathname}｜台灣醫藥監管週報，AI 協助彙整、醫師審閱。本文不構成醫療或法規建議。</p>
					<p class="print-date">列印日期由瀏覽器產生｜文章更新日期：{last_updated.toISOString().split('T')[0]}</p>
				</div>
			</article>
		</main>
		<Footer />
		<script>
			document.querySelectorAll('.prose table').forEach((table) => {
				if (!table.parentElement?.classList.contains('table-wrapper')) {
					const wrapper = document.createElement('div');
					wrapper.className = 'table-wrapper';
					table.parentNode?.insertBefore(wrapper, table);
					wrapper.appendChild(table);
				}
				table.querySelectorAll('thead th').forEach((th) => {
					if (!th.getAttribute('scope')) th.setAttribute('scope', 'col');
				});
			});
		</script>
	</body>
</html>
